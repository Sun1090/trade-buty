# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# CONTRIBUTING.md 让贡献者 `cp .env.example .env.local`，所以示例文件必须入库；
# scripts/env-docs.mjs 会把它的键与 docs/env.md、代码实际读取的变量三方对账。
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 构建时生成的知识库资产（prebuild 脚本拷贝）
public/knowledge-assets/
public/search-index.json

# Lighthouse CI 产物
.lighthouseci/

# 构建期生成的知识库标题映射
src/lib/kb-titles.json

# playwright
test-results/
playwright-report/

# Supabase CLI local state
supabase/.temp/

# 本地跑门禁/探针留下的一次性脚本与日志：不进 git，也不该被 eslint 扫到
.gate-logs/
