# Trade Buty 环境变量示例
# 复制为 .env.local 填入真实值（.env.local 已在 .gitignore）

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# AI —— P3 AI 陪学
# 兼容任何 OpenAI Chat Completions / Embeddings 格式的端点
# 例：OpenAI 官方 https://api.openai.com/v1
#     OpenRouter https://openrouter.ai/api/v1（可调 Claude/GPT/Llama 等）
#     DeepSeek https://api.deepseek.com/v1
AI_API_URL=https://api.openai.com/v1
AI_API_KEY=your_api_key
AI_MODEL=gpt-4o-mini
# embedding 可用不同端点/模型（也可复用 AI_API_URL）
AI_EMBEDDING_URL=https://api.openai.com/v1
AI_EMBEDDING_MODEL=text-embedding-3-small
# embedding key（可与 AI_API_KEY 不同；留空则回退使用 AI_API_KEY）
# AI_EMBEDDING_KEY=your_embedding_api_key
# 检索配置覆盖（可选），threshold 为 0..1 的相似度阈值，如 {"chat":{"threshold":0.25}}
# AI_RETRIEVAL_JSON=
# 紧急总开关：设为字符串 false 隐藏全部 AI 入口（R3.10）
# NEXT_PUBLIC_AI_ENABLED=true

# 站点 URL（sitemap/robots/OG 用，Vercel 自动注入或手填）
NEXT_PUBLIC_SITE_URL=https://trade-buty.vercel.app

# 反馈导出鉴权（GET /api/ai/feedback/export 需 Authorization: Bearer）
# ADMIN_TOKEN=your_random_admin_token
