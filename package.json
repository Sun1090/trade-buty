    "kb:parity": "node scripts/check-locale-parity.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:nav-chain": "node scripts/check-nav-chain.mjs",
    "check:relative-links": "node scripts/check-relative-links.mjs",
    "check:search-index": "node scripts/check-search-index.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:structured-data": "node scripts/check-structured-data.mjs",
    "e2e": "playwright test e2e/smoke.spec.ts e2e/mobile-overflow.spec.ts e2e/pwa-offline.spec.ts e2e/full-site.spec.ts",
    "e2e:visual": "playwright test e2e/visual.spec.ts",
    "lhci": "lhci autorun",
    "check:mobile": "node scripts/check-mobile.mjs",
    "pretest": "node scripts/generate-kb-titles.mjs",
    "kb:inventory": "node scripts/content-inventory.mjs",
    "kb:gap-priority": "node scripts/content-gap-priority.mjs",
    "check:title-terminology": "node scripts/check-title-terminology.mjs",
    "check:description-quality": "node scripts/check-description-quality.mjs",
    "check:risk-warning": "node scripts/check-risk-warning.mjs",
    "kb:accept": "node scripts/accept-new-course.mjs",
    "check:slug-conflicts": "node scripts/check-slug-conflicts.mjs",
    "check:description-dupes": "node scripts/check-description-dupes.mjs",
    "kb:dry-run": "node scripts/dry-run-new-chapter.mjs",
    "check:kb-pointer": "node scripts/check-kb-pointer.mjs",
    "check:translation-history": "node scripts/check-translation-history.mjs",
    "check:kb-parity-budget": "node scripts/check-kb-parity-budget.mjs"
