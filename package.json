    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "kb:update": "bash scripts/update-knowledge.sh",
    "test": "vitest run",
    "quiz:coverage": "node scripts/quiz-coverage.mjs",
    "summary:coverage": "node scripts/summary-coverage.mjs",
    "check:ai-copy": "node scripts/check-ai-copy.mjs",
    "check:constitution": "node scripts/check-constitution.mjs",
    "check:frontmatter": "node scripts/check-frontmatter.mjs",
    "check:image-alt": "node scripts/check-image-alt.mjs",
    "check:quiz-mounts": "node scripts/check-quiz-mounts.mjs",
    "check:quiz-coverage": "node scripts/check-quiz-coverage.mjs",
    "check:sitemap": "node scripts/check-sitemap.mjs",
    "kb:diff": "node scripts/kb-diff.mjs --update --changelog docs/kb-changelog-draft.md",
    "kb:translation-status": "node scripts/translation-status.mjs",
    "check:glossary": "node scripts/check-glossary.mjs",
    "ops:faq-candidates": "node scripts/faq-candidates.mjs",
    "ops:link-patrol": "node scripts/link-patrol.mjs",
    "analyze": "ANALYZE=true next build",
    "kb:parity": "node scripts/check-locale-parity.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:search-index": "node scripts/check-search-index.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "e2e": "playwright test e2e/smoke.spec.ts",
    "e2e:visual": "playwright test e2e/visual.spec.ts",
    "lhci": "lhci autorun",
    "check:mobile": "node scripts/check-mobile.mjs",
    "pretest": "node scripts/generate-kb-titles.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.114.0",
    "drizzle-orm": "^0.45.2",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "lightweight-charts": "^5.2.1",
    "next": "16.3.1",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
