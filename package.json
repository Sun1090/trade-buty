    "build": "next build",
    "start": "next start",
    "audit:prod": "npm audit --omit=dev --audit-level=high --registry=https://registry.npmjs.org",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "kb:update": "bash scripts/update-knowledge.sh",
    "test": "vitest run",
    "quiz:coverage": "node scripts/quiz-coverage.mjs",
    "summary:coverage": "node scripts/summary-coverage.mjs",
    "check:ai-copy": "node scripts/check-ai-copy.mjs",
    "check:growth-event-privacy": "node scripts/growth-event-privacy.mjs",
    "check:dark-pattern-copy": "node scripts/check-dark-pattern-copy.mjs",
    "check:constitution": "node scripts/check-constitution.mjs",
    "check:frontmatter": "node scripts/check-frontmatter.mjs",
    "check:image-alt": "node scripts/check-image-alt.mjs",
    "check:quiz-mounts": "node scripts/check-quiz-mounts.mjs",
    "check:quiz-coverage": "node scripts/check-quiz-coverage.mjs",
    "check:sitemap": "node scripts/check-sitemap.mjs",
    "check:seo-surface": "node scripts/check-seo-surface.mjs",
    "kb:diff": "node scripts/kb-diff.mjs --update --changelog docs/kb-changelog-draft.md",
    "kb:changelog": "node scripts/check-kb-changelog.mjs",
    "kb:translation-status": "node scripts/translation-status.mjs",
    "check:glossary": "node scripts/check-glossary.mjs",
    "ops:faq-candidates": "node scripts/faq-candidates.mjs",
    "ops:link-patrol": "node scripts/link-patrol.mjs",
